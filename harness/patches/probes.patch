+' SPDX-License-Identifier: GPL-3.0-or-later
+' Copyright (C) 2026 Aurora Jahan
+' Licensed under the GNU GPL v3 or later, WITHOUT ANY WARRANTY; see LICENSE.txt.
+' Ported from GEF 2025/1.2, Copyright (C) 2009-2025 Karl-Heinz Schmidt and Beatriz Jurado.
+' Harness patch "probes", probe T0: static tables and parameters as loaded, after GEF.bas:1570.
+' Written once per process (guard HP_Count(0)). Format and variable list: harness/PROBES.md.
+' Contains a copy of the BranchData/INlast loader of Branchings.bas (marked below), writing to
+' private arrays, because GEF itself loads BranchData only in the post-pass.
+
+#ifdef GEF_PROBES
+#include once "harness_probes.bi"
+
+If HP_Count(0) = 0 Then
+  HP_Begin(0, "T0", "-", "-", "-")
+  ' --- table sizes
+  HP_V(N_MAT_MAX)
+  HP_V(N_ISO_TOT)
+  HP_V(N_Anl)
+  #ifdef B_delayed
+    HP_V(Z_min_branching)
+    HP_V(Z_max_branching)
+    HP_V(A_max_branching)
+  #endif
+  ' --- mass, shell and deformation tables
+  HP_A2(BEldmTF)
+  HP_A2(BEexp)
+  HP_A2(DEFOtab)
+  HP_A2(ShellMO)
+  HP_S2(EVOD)
+  ' --- element names
+  HP_A1(CElement)
+  ' --- neutron-spectrum bin limits (Spectra.bas:798)
+  HP_A1(ENfrvar_lim)
+  ' --- NucTab / MAT_for_ISO / Isotab
+  HP_A1(MAT_for_ISO)
+  HP_F1(NucTab, I_Z, 0, N_MAT_MAX)
+  HP_F1(NucTab, I_A, 0, N_MAT_MAX)
+  HP_F1(NucTab, I_ISO, 0, N_MAT_MAX)
+  HP_F1(NucTab, R_SPI, 0, N_MAT_MAX)
+  HP_F1(NucTab, I_PAR, 0, N_MAT_MAX)
+  HP_F1(NucTab, R_AWR, 0, N_MAT_MAX)
+  HP_F1(NucTab, R_EXC, 0, N_MAT_MAX)
+  HP_F1(Isotab, I_MAT, 0, N_ISO_TOT)
+  HP_F1(Isotab, I_Z, 0, N_ISO_TOT)
+  HP_F1(Isotab, I_A, 0, N_ISO_TOT)
+  HP_F1(Isotab, N_STATES, 0, N_ISO_TOT)
+  HP_FA1(Isotab, I_ISO, 0, N_ISO_TOT)
+  HP_FA1(Isotab, R_SPI, 0, N_ISO_TOT)
+  HP_FA1(Isotab, I_PAR, 0, N_ISO_TOT)
+  HP_FA1(Isotab, R_EXC, 0, N_ISO_TOT)
+  HP_FA1(Isotab, R_Lim, 0, N_ISO_TOT)
+  HP_FA1(Isotab, R_Prob, 0, N_ISO_TOT)
+  ' --- BranchData / INlast: result of the Branchings.bas loader, private arrays
+  #ifdef B_delayed
+  Scope
+    Static As BranchType HP_BranchData(0 To 3425)
+    Static As Integer HP_INlast(0 To 90)
+    ' BEGIN copy of Branchings.bas:44-251 (BranchData -> HP_BranchData, INlast -> HP_INlast)
+
+      Scope
+        Dim As Integer I_Branch = 0
+        Dim As Single Rtot_beta,Rtot_beta_m,Rtot_beta_mm
+        Dim As Single Rtot_beta_plus,Rtot_beta_plus_m,Rtot_beta_plus_mm
+        Dim As Single beta_np,beta_2np
+        Dim As Single t,r_unit
+        Dim As String unit
+        Dim As Integer I_m
+        Dim As Single R_Dummy
+
+        Dim As Integer I_Work
+        Dim As Single R_Work
+
+        Dim As Integer Alarm = -1
+
+
+        Restore BranchTable
+
+        Do
+          Read I_Work
+          If I_Work > 0 Then  ' negative I_Work denotes decays into isomers
+            I_Branch = I_Branch + 1
+          End If
+          HP_BranchData(I_Branch).I_Z = Abs(I_Work)
+      '    If HP_BranchData(I_Branch).I_Z < 20 or HP_BranchData(I_Branch).I_Z > 110 Then
+      '      Print "<E> Error in branching table: Z , nmbr",I_Work, I_Branch
+      '      Print "GEF stopped."
+      '      Sleep
+      '    End If
+          Read HP_BranchData(I_Branch).I_A
+          Read HP_BranchData(I_Branch).I_ISO
+          If HP_BranchData(I_Branch).I_ISO < 0 or HP_BranchData(I_Branch).I_ISO > 9 Then
+            Print "<E> Error in branching table: I_ISO, nmbr ",HP_BranchData(I_Branch).I_ISO, I_Branch
+            Print "GEF stopped."
+            Sleep
+          End If
+
+          Read t
+          Read unit
+
+    ' Print I_work, I_Branch, HP_BranchData(I_Branch).I_Z,HP_BranchData(I_Branch).I_A,HP_BranchData(I_Branch).I_ISO,t, unit
+
+          If I_Work > 0 Then
+            I_m = 0
+
+            Read Rtot_beta
+            Rtot_beta = Rtot_beta * 0.01
+
+            Read Rtot_beta_plus
+            Rtot_beta_plus = Rtot_beta_plus * 0.01
+
+            Read beta_np
+            beta_np = beta_np * 0.01
+
+            Read beta_2np
+            beta_2np = beta_2np * 0.01
+
+            If Rtot_beta > 0 Then
+              HP_BranchData(I_Branch).R_beta_n = beta_np
+              HP_BranchData(I_Branch).R_beta_2n = beta_2np
+            End If
+
+            If Rtot_beta_plus > 0 Then
+              HP_BranchData(I_Branch).R_beta_p = beta_np
+              HP_BranchData(I_Branch).R_beta_2p = beta_2np
+            End If
+
