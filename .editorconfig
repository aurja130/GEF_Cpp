root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{cpp,hpp,h,c,cc,cxx,in}]
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[{.clang-format,.clang-tidy}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.sh]
indent_size = 4

# The BASIC reference source is a read-only submodule; never reformat it.
[Reference/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
