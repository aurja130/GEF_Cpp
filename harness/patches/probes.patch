+' SPDX-License-Identifier: GPL-3.0-or-later
+' Copyright (C) 2026 Aurora Jahan
+' Licensed under the GNU GPL v3 or later, WITHOUT ANY WARRANTY; see LICENSE.txt.
+' Harness patch "probes" (define GEF_PROBES): shared writer procedures and dump macros.
+' The probe points (harness_probe_t0.bi, _p1.bi, _p2.bi, _p3.bi) include this file once.
+' Everything here only READS GEF variables: no ReDim, no random draw, no change of any
+' value or of control flow. The format is specified in harness/PROBES.md.
+'
+' Record line:  <ID> <context> <NAME> <idx|-> <type> <value>
+'   type S: Single, 8 hex digits of the bit pattern; D: Double, 16 hex digits;
+'   I: integer types, decimal; Z: string, quoted with escapes;
+'   B / BS: array bounds record, value "<element type S|D|I|Z> lo:hi,lo:hi"; B = dense array,
+'           BS = sparse array (elements whose bit pattern is zero are omitted).
+
+#ifdef GEF_PROBES
+
+#ifndef HP_PROBES_DEFINED
+#define HP_PROBES_DEFINED
+
+Dim Shared As Long HP_File = 0
+Dim Shared As String HP_Prefix
+Dim Shared As Long HP_Count(0 To 3)
+
+Function HP_Esc(ByRef Cin As String) As String
+  Dim As String Cout = """"
+  Dim As Long Ichar, Ic
+  For Ichar = 1 To Len(Cin)
+    Ic = Cin[Ichar - 1]
+    If Ic = 34 Or Ic = 92 Then
+      Cout = Cout + "\" + Chr(Ic)
+    ElseIf Ic < 32 Or Ic > 126 Then
+      Cout = Cout + "\x" + Hex(Ic, 2)
+    Else
+      Cout = Cout + Chr(Ic)
+    End If
+  Next Ichar
+  Return Cout + """"
+End Function
+
+Function HP_Hex Overload (ByVal x As Single) As String
+  Dim As ULong Ubits = *CPtr(ULong Ptr, @x)
+  Return Hex(Ubits, 8)
+End Function
+
+Function HP_Hex Overload (ByVal x As Double) As String
+  Dim As ULongInt Ubits = *CPtr(ULongInt Ptr, @x)
+  Return Hex(Ubits, 16)
+End Function
+
+Function HP_Nz Overload (ByVal x As Single) As Long
+  Dim As ULong Ubits = *CPtr(ULong Ptr, @x)
+  Return Ubits <> 0
+End Function
+
+Function HP_Nz Overload (ByVal x As Double) As Long
+  Dim As ULongInt Ubits = *CPtr(ULongInt Ptr, @x)
+  Return Ubits <> 0
+End Function
+
+Function HP_Nz Overload (ByVal x As LongInt) As Long
+  Return x <> 0
+End Function
+
+Function HP_Nz Overload (ByVal x As ULongInt) As Long
+  Return x <> 0
+End Function
+
+Sub HP_Begin(ByVal Iprobe As Long, ByRef Cid As String, ByRef Cstep As String, ByRef Cpass As String, ByRef Cbin As String)
+  Dim As Long Ierr = MkDir("probes")
+  HP_Count(Iprobe) = HP_Count(Iprobe) + 1
+  If Iprobe = 0 Then
+    HP_Prefix = Cid + " - "
+  Else
+    HP_Prefix = Cid + " step=" + Cstep + " pass=" + Cpass + " bin=" + Cbin + " rec=" + Trim(Str(HP_Count(Iprobe))) + " "
+  End If
+  HP_File = FreeFile
+  If Open("probes/" + Cid + ".txt" For Append As #HP_File) <> 0 Then
+    Print "<harness> cannot open probes/" + Cid + ".txt"
+    End 3
+  End If
+End Sub
+
+Sub HP_End()
+  Close #HP_File
+  HP_File = 0
+End Sub
+
+Sub HP_Line(ByRef Cname As String, ByRef Cidx As String, ByRef Ctype As String, ByRef Cval As String)
+  Print #HP_File, HP_Prefix + Cname + " " + Cidx + " " + Ctype + " " + Cval
+End Sub
+
+Function HP_Ty Overload (ByVal x As Single) As String
+  Return "S"
+End Function
+
+Function HP_Ty Overload (ByVal x As Double) As String
+  Return "D"
+End Function
+
+Function HP_Ty Overload (ByVal x As Byte) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As UByte) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As Short) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As UShort) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As Long) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As ULong) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As Integer) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As UInteger) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As LongInt) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByVal x As ULongInt) As String
+  Return "I"
+End Function
+
+Function HP_Ty Overload (ByRef x As String) As String
+  Return "Z"
+End Function
+
+Sub HP_Bounds(ByRef Cname As String, ByRef Ctype As String, ByRef Cbounds As String, ByVal Bsparse As Long)
+  If Bsparse Then
+    HP_Line(Cname, "-", "BS", Ctype + " " + Cbounds)
+  Else
+    HP_Line(Cname, "-", "B", Ctype + " " + Cbounds)
+  End If
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As Single)
+  HP_Line(Cname, Cidx, "S", HP_Hex(x))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As Double)
+  HP_Line(Cname, Cidx, "D", HP_Hex(x))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As Byte)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As UByte)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As Short)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As UShort)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As Long)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As ULong)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As Integer)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As UInteger)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As LongInt)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByVal x As ULongInt)
+  HP_Line(Cname, Cidx, "I", Trim(Str(x)))
+End Sub
+
+Sub HP_Val Overload (ByRef Cname As String, ByRef Cidx As String, ByRef x As String)
+  HP_Line(Cname, Cidx, "Z", HP_Esc(x))
+End Sub
+
+' Scalar.
+#define HP_V(a) HP_Val(#a, "-", a)
+
+' Array, dense (every element over the current bounds) or sparse (only elements whose
+' bit pattern is non-zero; the bounds record says "BS"). Rank 1 to 4.
+#macro HP_A1N(n, a)
+  HP_Bounds(n, HP_Ty(a(LBound(a, 1))), Trim(Str(LBound(a, 1))) + ":" + Trim(Str(UBound(a, 1))), 0)
+  For hp_i1 As Long = LBound(a, 1) To UBound(a, 1)
+    HP_Val(n, Trim(Str(hp_i1)), a(hp_i1))
+  Next hp_i1
+#endmacro
+
+#define HP_A1(a) HP_A1N(#a, a)
+
+#macro HP_A2(a)
+  HP_Bounds(#a, HP_Ty(a(LBound(a, 1), LBound(a, 2))), Trim(Str(LBound(a, 1))) + ":" + Trim(Str(UBound(a, 1))) + "," + _
+                Trim(Str(LBound(a, 2))) + ":" + Trim(Str(UBound(a, 2))), 0)
+  For hp_i1 As Long = LBound(a, 1) To UBound(a, 1)
+    For hp_i2 As Long = LBound(a, 2) To UBound(a, 2)
+      HP_Val(#a, Trim(Str(hp_i1)) + "," + Trim(Str(hp_i2)), a(hp_i1, hp_i2))
+    Next hp_i2
+  Next hp_i1
+#endmacro
+
+#macro HP_A3(a)
+  HP_Bounds(#a, HP_Ty(a(LBound(a, 1), LBound(a, 2), LBound(a, 3))), Trim(Str(LBound(a, 1))) + ":" + Trim(Str(UBound(a, 1))) + "," + _
+                Trim(Str(LBound(a, 2))) + ":" + Trim(Str(UBound(a, 2))) + "," + _
+                Trim(Str(LBound(a, 3))) + ":" + Trim(Str(UBound(a, 3))), 0)
+  For hp_i1 As Long = LBound(a, 1) To UBound(a, 1)
+    For hp_i2 As Long = LBound(a, 2) To UBound(a, 2)
+      For hp_i3 As Long = LBound(a, 3) To UBound(a, 3)
+        HP_Val(#a, Trim(Str(hp_i1)) + "," + Trim(Str(hp_i2)) + "," + Trim(Str(hp_i3)), a(hp_i1, hp_i2, hp_i3))
+      Next hp_i3
+    Next hp_i2
+  Next hp_i1
+#endmacro
+
+#macro HP_S1(a)
+  HP_Bounds(#a, HP_Ty(a(LBound(a, 1))), Trim(Str(LBound(a, 1))) + ":" + Trim(Str(UBound(a, 1))), 1)
+  For hp_i1 As Long = LBound(a, 1) To UBound(a, 1)
+    If HP_Nz(a(hp_i1)) Then HP_Val(#a, Trim(Str(hp_i1)), a(hp_i1))
+  Next hp_i1
+#endmacro
+
+#macro HP_S2(a)
+  HP_Bounds(#a, HP_Ty(a(LBound(a, 1), LBound(a, 2))), Trim(Str(LBound(a, 1))) + ":" + Trim(Str(UBound(a, 1))) + "," + _
+                Trim(Str(LBound(a, 2))) + ":" + Trim(Str(UBound(a, 2))), 1)
+  For hp_i1 As Long = LBound(a, 1) To UBound(a, 1)
+    For hp_i2 As Long = LBound(a, 2) To UBound(a, 2)
+      If HP_Nz(a(hp_i1, hp_i2)) Then HP_Val(#a, Trim(Str(hp_i1)) + "," + Trim(Str(hp_i2)), a(hp_i1, hp_i2))
+    Next hp_i2
+  Next hp_i1
+#endmacro
+
+#macro HP_S3(a)
+  HP_Bounds(#a, HP_Ty(a(LBound(a, 1), LBound(a, 2), LBound(a, 3))), Trim(Str(LBound(a, 1))) + ":" + Trim(Str(UBound(a, 1))) + "," + _
+                Trim(Str(LBound(a, 2))) + ":" + Trim(Str(UBound(a, 2))) + "," + _
+                Trim(Str(LBound(a, 3))) + ":" + Trim(Str(UBound(a, 3))), 1)
+  For hp_i1 As Long = LBound(a, 1) To UBound(a, 1)
+    For hp_i2 As Long = LBound(a, 2) To UBound(a, 2)
+      For hp_i3 As Long = LBound(a, 3) To UBound(a, 3)
+        If HP_Nz(a(hp_i1, hp_i2, hp_i3)) Then _
+          HP_Val(#a, Trim(Str(hp_i1)) + "," + Trim(Str(hp_i2)) + "," + Trim(Str(hp_i3)), a(hp_i1, hp_i2, hp_i3))
+      Next hp_i3
+    Next hp_i2
+  Next hp_i1
+#endmacro
+
+#macro HP_S4(a)
+  HP_Bounds(#a, HP_Ty(a(LBound(a, 1), LBound(a, 2), LBound(a, 3), LBound(a, 4))), Trim(Str(LBound(a, 1))) + ":" + Trim(Str(UBound(a, 1))) + "," + _
+                Trim(Str(LBound(a, 2))) + ":" + Trim(Str(UBound(a, 2))) + "," + _
+                Trim(Str(LBound(a, 3))) + ":" + Trim(Str(UBound(a, 3))) + "," + _
+                Trim(Str(LBound(a, 4))) + ":" + Trim(Str(UBound(a, 4))), 1)
+  For hp_i1 As Long = LBound(a, 1) To UBound(a, 1)
+    For hp_i2 As Long = LBound(a, 2) To UBound(a, 2)
+      For hp_i3 As Long = LBound(a, 3) To UBound(a, 3)
+        For hp_i4 As Long = LBound(a, 4) To UBound(a, 4)
+          If HP_Nz(a(hp_i1, hp_i2, hp_i3, hp_i4)) Then _
+            HP_Val(#a, Trim(Str(hp_i1)) + "," + Trim(Str(hp_i2)) + "," + Trim(Str(hp_i3)) + "," + Trim(Str(hp_i4)), _
+                   a(hp_i1, hp_i2, hp_i3, hp_i4))
+        Next hp_i4
+      Next hp_i3
+    Next hp_i2
+  Next hp_i1
+#endmacro
+
+' Field of a one-dimensional array of UDT elements, over lo..hi:  a(i).f  -> NAME "a.f"
+' (HP_F1N takes the NAME explicitly).
+#macro HP_F1N(n, a, f, lo, hi)
+  HP_Bounds(n, HP_Ty(a(lo).f), Trim(Str(lo)) + ":" + Trim(Str(hi)), 0)
+  For hp_i1 As Long = lo To hi
+    HP_Val(n, Trim(Str(hp_i1)), a(hp_i1).f)
+  Next hp_i1
+#endmacro
+
+#define HP_F1(a, f, lo, hi) HP_F1N(#a + "." + #f, a, f, lo, hi)
+
+' Sparse variant of HP_F1 (zero fields omitted).
+#macro HP_FS1(a, f, lo, hi)
+  HP_Bounds(#a + "." + #f, HP_Ty(a(lo).f), Trim(Str(lo)) + ":" + Trim(Str(hi)), 1)
+  For hp_i1 As Long = lo To hi
+    If HP_Nz(a(hp_i1).f) Then HP_Val(#a + "." + #f, Trim(Str(hp_i1)), a(hp_i1).f)
+  Next hp_i1
+#endmacro
+
+' Array field (one dimension) of a one-dimensional UDT array: a(i).f(j)  -> idx "i,j".
+#macro HP_FA1(a, f, lo, hi)
+  HP_Bounds(#a + "." + #f, HP_Ty(a(lo).f(LBound(a(lo).f, 1))), Trim(Str(lo)) + ":" + Trim(Str(hi)) + "," + _
+            Trim(Str(LBound(a(lo).f, 1))) + ":" + Trim(Str(UBound(a(lo).f, 1))), 0)
+  For hp_i1 As Long = lo To hi
+    For hp_i2 As Long = LBound(a(lo).f, 1) To UBound(a(lo).f, 1)
+      HP_Val(#a + "." + #f, Trim(Str(hp_i1)) + "," + Trim(Str(hp_i2)), a(hp_i1).f(hp_i2))
+    Next hp_i2
+  Next hp_i1
+#endmacro
+
+' Array field (two dimensions) of a one-dimensional UDT array: a(i).f(j,k)  -> idx "i,j,k".
+#macro HP_FA2(a, f, lo, hi)
+  HP_Bounds(#a + "." + #f, HP_Ty(a(lo).f(LBound(a(lo).f, 1), LBound(a(lo).f, 2))), Trim(Str(lo)) + ":" + Trim(Str(hi)) + "," + _
+            Trim(Str(LBound(a(lo).f, 1))) + ":" + Trim(Str(UBound(a(lo).f, 1))) + "," + _
+            Trim(Str(LBound(a(lo).f, 2))) + ":" + Trim(Str(UBound(a(lo).f, 2))), 0)
+  For hp_i1 As Long = lo To hi
+    For hp_i2 As Long = LBound(a(lo).f, 1) To UBound(a(lo).f, 1)
+      For hp_i3 As Long = LBound(a(lo).f, 2) To UBound(a(lo).f, 2)
+        HP_Val(#a + "." + #f, Trim(Str(hp_i1)) + "," + Trim(Str(hp_i2)) + "," + Trim(Str(hp_i3)), a(hp_i1).f(hp_i2, hp_i3))
+      Next hp_i3
+    Next hp_i2
+  Next hp_i1
+#endmacro
+
+#endif ' HP_PROBES_DEFINED
+
+#endif ' GEF_PROBES
